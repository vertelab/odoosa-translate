msgid ""
msgstr ""
"Project-Id-Version: odoosa-diff-hr_holidays\n"
"Language: sv\n"

#. module: hr_holidays
# override | officiell: 'Tillåt att skapa förfrågningar i batcher:\n- Per
# anställd: för en specifik anställd\n- Per företag: alla anställda i det
# angivna företaget\n- Per avdelning: alla anställda i den angivna
# avdelningen\n- Per anställdetikett: alla anställda i den specifika
# anställdgruppkategorin'
msgid ""
"Allow to create requests in batchs:\n"
"- By Employee: for a specific employee\n"
"- By Company: all employees of the specified company\n"
"- By Department: all employees of the specified department\n"
"- By Employee Tag: all employees of the specific employee group category"
msgstr ""
"Tillåt att skapa förfrågningar i batcher:\n"
"- Per anställd: för en specifik anställd\n"
"- Per bolag: alla anställda i det angivna bolaget\n"
"- Per avdelning: alla anställda i den angivna avdelningen\n"
"- Per anställdetikett: alla anställda i den specifika anställdgruppkategorin"

#. module: hr_holidays
# conflict | officiell: 'Företag'
msgid "Company"
msgstr "Bolag"

#. module: hr_holidays
# override | officiell: 'Anställda Företag'
msgid "Employee Company"
msgstr "Anställda Bolag"

#. module: hr_holidays
# override | officiell: 'Den anställde arbetar inte längre i företaget'
msgid "The employee no longer works in the company"
msgstr "Den anställde arbetar inte längre i bolaget"

#. module: hr_holidays
# override | officiell: 'Det finns ingen anställd som är inställd på ledig
# tid. Kontrollera att du är inloggad på rätt företag.'
msgid ""
"There is no employee set on the time off. Please make sure you're logged in "
"the correct company."
msgstr ""
"Det finns ingen anställd som är inställd på ledig tid. Kontrollera att du är"
" inloggad på rätt bolag."

#. module: hr_holidays
# override | officiell: 'Giltighet Slutdatum har uppdaterats eftersom
# medarbetaren inte längre arbetar i företaget'
msgid ""
"Validity End date has been updated because Employee no longer works in the "
"company"
msgstr ""
"Giltighet Slutdatum har uppdaterats eftersom medarbetaren inte längre "
"arbetar i bolaget"

#. module: hr_holidays
# override | officiell: 't.ex. extra återhämtning, företaget är inte
# tillgängligt, ...'
msgid "e.g. Extra recuperation, Company unavailability, ..."
msgstr "t.ex. extra återhämtning, bolaget är inte tillgängligt, ..."
