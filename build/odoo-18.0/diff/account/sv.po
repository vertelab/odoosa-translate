# momsregistreringsnummer'
msgid "Countries for which the company has a VAT number"
msgstr "Länder för vilka bolaget har ett momsregistreringsnummer"

#. module: account
# override | officiell: 'Skapa bokföringsposter automatiskt'
msgid "Create Automatic Entries"
msgstr "Skapa verifikat automatiskt"

#. module: account
# override | officiell: 'Skapa bokföringspost'
msgid "Create Entry"
msgstr "Skapa verifikat"

#. module: account
