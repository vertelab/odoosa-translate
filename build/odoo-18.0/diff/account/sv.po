# override | officiell: 'Analytiska fördelningsmodeller'
msgid "Analytic Distribution Model"
msgstr "Objektfördelning"

#. module: account
# override | officiell: 'Analytiska fördelningsmodeller'
msgid "Analytic Distribution Models"
msgstr "Objektfördelning"

#. module: account
# override | officiell: 'Analytiska filter'
msgid "Analytic Filter"
