msgid "Create Journal Entries"
msgstr "Skapa verifikat"

#. module: account
# override | officiell: 'Skapa en bokföringspost'
msgid "Create a journal entry"
msgstr "Skapa en verifikat"

#. module: account
# override | officiell: 'Journalhändelser med kreditbelopp som matchas med
# denna journalhändelse.'
msgid "Credit journal items that are matched with this journal item."
msgstr "Verifikatsrader med kreditbelopp som matchas med denna verifikatsrad."

#. module: account
# override | officiell: 'Valutan som journalhändelsens kreditbelopp är angivet
# i.'
msgid "Currency of the credit journal item."
msgstr "Valutan som verifikatsradens kreditbelopp är angivet i."

#. module: account
# override | officiell: 'Valutan som journalhändelsens debetbelopp är angivet
# i.'
msgid "Currency of the debit journal item."
msgstr "Valutan som verifikatsradens debetbelopp är angivet i."

#. module: account
# override | officiell: 'Växelkurs vid omvandling från företagets valuta till
# dokumentets valuta.'
msgid "Currency rate from company currency to document currency."
msgstr ""
"Växelkurs vid omvandling från bolagets valuta till dokumentets valuta."

#. module: account
# override | officiell: 'Datum (till och med) då numren ska omordnas. Om inget
# datum anges, så omordnas alla bokföringsposter fram till periodens slut.'
msgid ""
"Date (inclusive) to which the numbers are resequenced. If not set, all "
"Journal Entries up to the end of the period are resequenced."
msgstr ""
"Datum (till och med) då numren ska omordnas. Om inget datum anges, så "
"omordnas alla verifikat fram till periodens slut."

#. module: account
# override | officiell: 'Debitera journalhändelser som matchar denna
# journalhändelse.'
msgid "Debit journal items that are matched with this journal item."
msgstr "Debitera verifikatsrader som matchar denna verifikatsrad."

#. module: account
# override | officiell: 'Standard incotermer för företaget'
msgid "Default Incoterm of your company"
msgstr "Standard incotermer för bolaget"

#. module: account
# override | officiell: 'Standard om huruvida det försäljningspris som används
# för företagets produkter och fakturor ska inkludera moms.'
msgid ""
"Default on whether the sales price used on the product and invoices with "
"this Company includes its taxes."
msgstr ""
"Standard om huruvida det försäljningspris som används för bolagets produkter"
" och fakturor ska inkludera moms."

#. module: account
# override | officiell: 'Ange vilket företag som kan välja
# flerföretagshuvudboken i rapportfilter. Om inget företag anges så är det
# tillgängligt för alla företag'
msgid ""
"Define which company can select the multi-ledger in report filters. If none "
"is provided, available for all companies"
msgstr ""
"Ange vilket bolag som kan välja flerbolagshuvudboken i rapportfilter. Om "
