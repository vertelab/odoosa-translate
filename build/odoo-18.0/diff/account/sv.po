#. module: account
# override | officiell: 'Analytiska rader'
msgid "Analytic Lines"
msgstr "Objektrader"

#. module: account
# override | officiell: 'Analytiska planers användningsgrad'
msgid "Analytic Plan's Applicabilities"
msgstr "Objektreglers användningsgrad"

#. module: account
# override | officiell: 'Analytiska planer'
msgid "Analytic Plans"
msgstr "Objektregler"

#. module: account
# override | officiell: 'Analytisk precision'
