#. module: account
# override | officiell: '%(move)s är i ett ogiltigt tillstånd när det kommer
# till den relaterade raden i kontoutdraget.\nFör att upprätthålla konsekvens
# måste bokföringsposten alltid ha exakt en interimrad.'
msgid ""
"%(move)s reached an invalid state regarding its related statement line.\n"
"To be consistent, the journal entry must always have exactly one suspense line."
msgstr ""
"%(move)s är i ett ogiltigt tillstånd när det kommer till den relaterade raden i kontoutdraget.\n"
"För att upprätthålla konsekvens måste verifikatet alltid ha exakt en interimrad."

#. module: account
# override | officiell: '-> Visa delvis avstämda bokföringsposter'
msgid "-> View partially reconciled entries"
msgstr "-> Visa delvis avstämda verifikat"

#. module: account
# override | officiell: '. Beloppet i bokföringsposten måste beräknas av Odoo
# innan den kan bokföras i ditt företags valuta.'
msgid ""
". The journal entries need to be computed by Odoo before being posted in "
"your company's currency."
msgstr ""
". Beloppet i verifikatet måste beräknas av Odoo innan den kan bokföras i "
"ditt bolags valuta."

