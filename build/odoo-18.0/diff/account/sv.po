msgstr "<span class=\"o_stat_text\">Verifikat enligt kontantmetoden</span>"

#. module: account
# override | officiell: '<span class="o_stat_text">Bokföringsposter</span>'
msgid "<span class=\"o_stat_text\">Journal Entries</span>"
msgstr "<span class=\"o_stat_text\">Verifikat</span>"

#. module: account
# override | officiell: '<span class="o_stat_text">Bokföringspost</span>'
msgid "<span class=\"o_stat_text\">Journal Entry</span>"
msgstr "<span class=\"o_stat_text\">Verifikat</span>"

#. module: account
# override | officiell: '<span class="o_stat_text">Avstämda
# journalhändelser</span>'
msgid "<span class=\"o_stat_text\">Reconciled Items</span>"
msgstr "<span class=\"o_stat_text\">Avstämda verifikatsrader</span>"

#. module: account
# override | officiell: '<span class="text-muted">\n
# <i>Säkra bokföringsposter upp till</i>\n                            </span>'
msgid ""
"<span class=\"text-muted\">\n"
"                                <i>Secure entries up to</i>\n"
"                            </span>"
msgstr ""
"<span class=\"text-muted\">\n"
"                                <i>Säkra verifikat upp till</i>\n"
"                            </span>"

#. module: account
# override | officiell: '<span>bokföringsposten har skapats genom appen
# Faktura innan Bokföring installerades. Saldot har importerats
# separat.</span>'
msgid ""
"<span>This entry has been generated through the Invoicing app, before "
"installing Accounting. Its balance has been imported separately.</span>"
msgstr ""
"<span>verifikatet har skapats genom appen Faktura innan Bokföring "
"installerades. Saldot har importerats separat.</span>"

#. module: account
# override | officiell: 'Ett kassaregister låter dig hantera kontanta
# bokföringsposter genom dina\n                kontantjournaler. Funktionen
# gör det enkelt att dagligen hålla uppsikt\n                över kontanta
# betalningar.'
msgid ""
"A Cash Register allows you to manage cash entries in your cash\n"
"                journals. This feature provides an easy way to follow up cash\n"
"                payments on a daily basis."
msgstr ""
"Ett kassaregister låter dig hantera kontanta verifikat genom dina\n"
"                kontantjournaler. Funktionen gör det enkelt att dagligen hålla uppsikt\n"
"                över kontanta betalningar."

#. module: account
# override | officiell: 'Namnet på en huvudboksgrupp måste vara unikt för
# varje företag.'
msgid "A Ledger group name must be unique per company."
msgstr "Namnet på en huvudboksgrupp måste vara unikt för varje bolag."

#. module: account
# override | officiell: 'En bokföringspost består av flera journalhändelser
# där varje \n                händelse antingen utgör en debet- eller
# kredittransaktion.'
msgid ""
"A journal entry consists of several journal items, each of\n"
"                which is either a debit or a credit transaction."
msgstr ""
"En verifikat består av flera verifikatsrader där varje \n"
"                händelse antingen utgör en debet- eller kredittransaktion."

#. module: account
# override | officiell: 'En betalning med ett utestående konto kan inte
# bekräftas utan en bokföringspost.'
msgid ""
"A payment with an outstanding account cannot be confirmed without having a "
"journal entry."
msgstr ""
"En betalning med ett utestående konto kan inte bekräftas utan en verifikat."

#. module: account
# override | officiell: 'Kontot %(account)s kommer att delas upp i
# %(num_accounts)s, ett för varje företag:'
msgid ""
"Account %(account)s will be split in %(num_accounts)s, one for each "
"company:\n"
msgstr ""
"Kontot %(account)s kommer att delas upp i %(num_accounts)s, ett för varje "
"bolag:"

#. module: account
# override | officiell: 'Kontot %s kan inte delas upp eftersom det redan
# tillhör ett enskilt företag. Åtgärden delar bara upp ett konto baserat på
# dess företag.'
msgid ""
"Account %s cannot be unmerged as it already belongs to a single company. The"
" unmerge operation only splits an account based on its companies."
msgstr ""
"Kontot %s kan inte delas upp eftersom det redan tillhör ett enskilt bolag. "
"Åtgärden delar bara upp ett konto baserat på dess bolag."

#. module: account
# override | officiell: 'Bokföringspost'
msgid "Account Entry"
msgstr "Verifikat"

#. module: account
# override | officiell: 'Konto har hashade bokföringsposter'
msgid "Account Has Hashed Entries"
msgstr "Konto har hashade verifikat"

#. module: account
# override | officiell: 'Konto som anges på rader i bokföringsposter skapade
# enligt kontantmetoden och som används för att spåra det grundläggande
# skattebeloppet.'
msgid ""
"Account that will be set on lines created in cash basis journal entry and "
"used to keep track of the tax base amount."
msgstr ""
"Konto som anges på rader i verifikat skapade enligt kontantmetoden och som "
"används för att spåra det grundläggande skattebeloppet."

#. module: account
# override | officiell: 'Konto med bokföringsposter'
msgid "Account with Entries"
msgstr "Konto med verifikat"

#. module: account
# override | officiell: 'Konto: Bokför utkast till bokföringsposter med
# auto_post aktiverat och bokföringsdatum fram till idag'
msgid ""
"Account: Post draft entries with auto_post enabled and accounting date up to"
" today"
msgstr ""
"Konto: Bokför utkast till verifikat med auto_post aktiverat och "
"bokföringsdatum fram till idag"

#. module: account
# override | officiell: 'Justering av bokföringspost'
msgid "Adjusting Entry"
msgstr "Justering av verifikat"

#. module: account
# override | officiell: 'Alla företag'
msgid "All Companies"
msgstr "Alla bolag"

#. module: account
# override | officiell: 'Alla markerade rättningsrörelser måste vara kopplade
# till samma företag.'
msgid "All selected moves for reversal must belong to the same company."
msgstr ""
"Alla markerade rättningsrörelser måste vara kopplade till samma bolag."

#. module: account
# override | officiell: 'Enbart positivt belopp kopplat till denna matchning
# och uttryckt i företagets valuta.'
msgid ""
"Always positive amount concerned by this matching expressed in the company "
"currency."
msgstr ""
"Enbart positivt belopp kopplat till denna matchning och uttryckt i bolagets "
"valuta."

#. module: account
# override | officiell: 'Undertecknat belopp i företagets valuta'
msgid "Amount Company Currency Signed"
msgstr "Undertecknat belopp i bolagets valuta"

#. module: account
# override | officiell: 'Belopp att betala (företagets valuta)'
msgid "Amount to Pay (company currency)"
msgstr "Belopp att betala (bolagets valuta)"

#. module: account
# override | officiell: 'Ett konto är en del av ett huvudbok som gör det
# möjligt för ditt företag\natt registrera alla typer av debet- och
# kredittransaktioner.\nFöretag presenterar sina årsredovisningar i två
# huvuddelar: en balansräkning\noch en resultaträkning (konton för vinster och
# förluster). Företag är skyldiga enligt lag\natt genom årsredovisningen
# presentera viss information.'
msgid ""
"An account is part of a ledger allowing your company\n"
"                to register all kinds of debit and credit transactions.\n"
"                Companies present their annual accounts in two main parts: the\n"
"                balance sheet and the income statement (profit and loss\n"
"                account). The annual accounts of a company are required by law\n"
"                to disclose a certain amount of information."
msgstr ""
"Ett konto är en del av ett huvudbok som gör det möjligt för ditt bolag\n"
"att registrera alla typer av debet- och kredittransaktioner.\n"
"Bolag presenterar sina årsredovisningar i två huvuddelar: en balansräkning\n"
"och en resultaträkning (konton för vinster och förluster). Bolag är skyldiga enligt lag\n"
"att genom årsredovisningen presentera viss information."

#. module: account
# override | officiell: 'Ett fel inträffade vid beräkningen av
# oföränderligheten. Alla bokföringsposter måste stämmas av.'
msgid ""
"An error occurred when computing the inalterability. All entries have to be "
"reconciled."
msgstr ""
"Ett fel inträffade vid beräkningen av oföränderligheten. Alla verifikat "
"måste stämmas av."

