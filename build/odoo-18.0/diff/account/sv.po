# override | officiell: 'Analytiskt konto'
msgid "Analytic Account"
msgstr "Objektkonto"

#. module: account
# override | officiell: 'Analytisk redovisning'
msgid "Analytic Accounting"
msgstr "Objektredovisning"

#. module: account
