#. module: portal
# override | officiell: '<small class="form-text text-muted">\n
# Företagsnamn, momsnummer och land kan inte ändras när dokument har utfärdats
# för ditt konto.\n                <br/>Vänligen kontakta oss direkt för denna
# åtgärd.\n            </small>'
msgid ""
"<small class=\"form-text text-muted\">\n"
"                Company name, VAT Number and country can not be changed once document(s) have been issued for your account.\n"
"                <br/>Please contact us directly for that operation.\n"
"            </small>"
msgstr ""
"<small class=\"form-text text-muted\">\n"
"                Bolagsnamn, momsnummer och land kan inte ändras när dokument har utfärdats för ditt konto.\n"
"                <br/>Vänligen kontakta oss direkt för denna åtgärd.\n"
"            </small>"

#. module: portal
# override | officiell: 'Det är inte tillåtet att ändra företagsnamn när
# dokument har utfärdats för ditt konto. Kontakta oss direkt för denna
# åtgärd.'
msgid ""
"Changing company name is not allowed once document(s) have been issued for "
"your account. Please contact us directly for this operation."
msgstr ""
"Det är inte tillåtet att ändra bolagsnamn när dokument har utfärdats för "
"ditt konto. Kontakta oss direkt för denna åtgärd."

#. module: portal
# override | officiell: 'Företagsnamn'
msgid "Company Name"
msgstr "Bolagsnamn"

#. module: portal
# override | officiell: 'Rapporter för flera företag stöds inte.'
msgid "Multi company reports are not supported."
msgstr "Rapporter för flera bolag stöds inte."
