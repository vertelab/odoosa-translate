msgid "Company Logo"
msgstr "Bolagslogo"

#. module: hr
# override | officiell: 'Företagets arbetstid'
msgid "Company Working Hours"
msgstr "Bolagets arbetstid"

#. module: hr
# override | officiell: 'Företagsanställd'
msgid "Company employee"
msgstr "Bolagsanställd"

#. module: hr
# override | officiell: 'Varje anställd har en chans att se effekterna av sitt
# arbete.\n                            Du kan göra ett verkligt bidrag till
# företagets framgång.\n                            <br>\n
# Flera aktiviteter organiseras ofta under hela året, till exempel veckovisa\n
# idrottssessioner, teambuilding-evenemang, månadsdrink och mycket mer.'
msgid ""
"Each employee has a chance to see the impact of his work.\n"
"                            You can make a real contribution to the success of the company.\n"
"                            <br>\n"
"                            Several activities are often organized all over the year, such as weekly\n"
"                            sports sessions, team building events, monthly drink, and much more."
msgstr ""
"Varje anställd har en chans att se effekterna av sitt arbete.\n"
"                            Du kan göra ett verkligt bidrag till bolagets framgång.\n"
"                            <br>\n"
"                            Flera aktiviteter organiseras ofta under hela året, till exempel veckovisa\n"
"                            idrottssessioner, teambuilding-evenemang, månadsdrink och mycket mer."

#. module: hr
# override | officiell: 'Verkligt ansvar och utmaningar i ett snabbt
# utvecklande företag'
msgid "Real responsibilities and challenges in a fast evolving company"
msgstr "Verkligt ansvar och utmaningar i ett snabbt utvecklande bolag"

#. module: hr
# override | officiell: 'Ange standardschema för företaget för att hantera de
# anställdas arbetstid'
msgid "Set default company schedule to manage your employees working time"
msgstr ""
"Ange standardschema för bolaget för att hantera de anställdas arbetstid"

#. module: hr
# override | officiell: 'Jobbets namn måste vara unikt per avdelning i
# företaget!'
msgid "The name of the job position must be unique per department in company!"
msgstr "Jobbets namn måste vara unikt per avdelning i bolaget!"

#. module: hr
# override | officiell: 'För att undvika problem med flera företag (förlora
# åtkomst till dina tidigare kontrakt, ledigheter, ...) ska du skapa en annan
# anställd i det nya företaget istället.'
msgid ""
"To avoid multi company issues (losing the access to your previous contracts,"
" leaves, ...), you should create another employee in the new company "
"instead."
msgstr ""
"För att undvika problem med flera bolag (förlora åtkomst till dina tidigare "
"kontrakt, ledigheter, ...) ska du skapa en annan anställd i det nya bolaget "
"istället."
