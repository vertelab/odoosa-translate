msgid "Update tax tags on existing Journal Entries"
msgstr "Uppdatera skattetaggar för befintliga verifikat"

#. module: account_update_tax_tags
#: model_terms:ir.ui.view,arch_db:account_update_tax_tags.view_account_update_tax_tags_wizard_form
msgid ""
"Updating tax tags on existing Journal Entries is an <b>irreversible</b> action that will impact\n"
"                    your reports.<br/>\n"
"                    It is highly recommended to backup your database beforehand.<br/>\n"
"                    The update will change tax tags on your accounting history, starting from and including selected date,\n"
"                    so that it matches with the current configuration of your taxes.<br/>"
msgstr ""
"Att uppdatera skattetaggar för befintliga verifikat är en <b>oåterkallelig</b> åtgärd som kommer att påverka\n"
"                    dina rapporter.<br/>\n"
"                    Vi rekommenderar starkt att man säkerhetskopierar sin databas innan man genomför åtgärden.<br/>\n"
"                    Uppdateringen kommer att ändra skattetaggarna i din bokföringshistorik, från och med och inklusive det valda datumet,\n"
"                    så att taggarna stämmer överens med den aktuella konfigurationen av dina skatter.<br/>"
