msgstr "Verkligt ansvar och utmaningar i ett snabbt utvecklande bolag"

#. module: hr
# override | officiell: 'Ange standardschema för företaget för att hantera de
# anställdas arbetstid'
msgid "Set default company schedule to manage your employees working time"
msgstr ""
"Ange standardschema för bolaget för att hantera de anställdas arbetstid"

#. module: hr
# override | officiell: 'Jobbets namn måste vara unikt per avdelning i
# företaget!'
msgid "The name of the job position must be unique per department in company!"
msgstr "Jobbets namn måste vara unikt per avdelning i bolaget!"

#. module: hr
# override | officiell: 'För att undvika problem med flera företag (förlora
# åtkomst till dina tidigare kontrakt, ledigheter, ...) ska du skapa en annan
# anställd i det nya företaget istället.'
msgid ""
"To avoid multi company issues (losing the access to your previous contracts,"
" leaves, ...), you should create another employee in the new company "
"instead."
msgstr ""
"För att undvika problem med flera bolag (förlora åtkomst till dina tidigare "
"kontrakt, ledigheter, ...) ska du skapa en annan anställd i det nya bolaget "
"istället."
