#. module: account_peppol
# override | officiell: 'Aktivt överordnat företag'
msgid "Active Parent Company"
msgstr "Aktivt överordnat bolag"

#. module: account_peppol
# override | officiell: 'Namn på aktivt överordnat företag'
msgid "Active Parent Company Name"
msgstr "Namn på aktivt överordnat bolag"

#. module: account_peppol
# override | officiell: 'Företag'
msgid "Companies"
msgstr "Bolag"

#. module: account_peppol
# override | officiell: 'Företag'
msgid "Company"
msgstr "Bolag"

#. module: account_peppol
# override | officiell: 'Företagets namn'
msgid "Company Name"
msgstr "Bolagets namn"

#. module: account_peppol
# override | officiell: 'Företagsinformation'
msgid "Company information"
msgstr "Bolagsinformation"

#. module: account_peppol
# override | officiell: 'Jag försäkrar om att jag har tillåtelse att
# registrera det här företaget.'
msgid "I reckon I'm allowed to register this company."
msgstr ""
"Jag försäkrar om att jag har tillåtelse att registrera det här bolaget."

#. module: account_peppol
# override | officiell: 'Är en filial av ett företag'
msgid "Is Branch Company"
msgstr "Är en filial av ett bolag"

#. module: account_peppol
# override | officiell: 'Överordnat företag'
msgid "Parent Company"
msgstr "Överordnat bolag"

#. module: account_peppol
# override | officiell: 'Peppol-ID bör skilja sig från huvudföretaget.'
msgid "Peppol ID should be different from main company."
msgstr "Peppol-ID bör skilja sig från huvudbolaget."

#. module: account_peppol
# override | officiell: 'Peppol överordnat företag'
msgid "Peppol Parent Company"
msgstr "Peppol överordnat bolag"

#. module: account_peppol
# override | officiell: 'Peppol namn på överordnat företag'
msgid "Peppol Parent Company Name"
msgstr "Peppol namn på överordnat bolag"

#. module: account_peppol
# override | officiell: 'Peppol använd överordnat företag'
msgid "Peppol Use Parent Company"
msgstr "Peppol använd överordnat bolag"

#. module: account_peppol
# override | officiell: 'Vänligen välj ett land för ditt företag.'
msgid "Please select a country for your company."
msgstr "Vänligen välj ett land för ditt bolag."

#. module: account_peppol
# override | officiell: 'Registrera företaget hos peppol'
msgid "Register this company on peppol"
msgstr "Registrera bolaget hos peppol"

#. module: account_peppol
# override | officiell: 'Utvalda företag'
msgid "Selected Company"
msgstr "Utvalda bolag"

#. module: account_peppol
# override | officiell: 'Skicka från överordnat företag'
msgid "Send from parent company"
msgstr "Skicka från överordnat bolag"

#. module: account_peppol
# override | officiell: 'Du är på väg att använda ett momsregistreringsnummer
# för att registrera dig. Försäkra dig om att du registrerar dig med ditt
# företagsregisternummer (BCE/KBO) för att följa gällande lagstiftning.'
msgid ""
"You are about to register with your VAT number. Make sure you register with "
"your Company Registry (BCE/KBO) first to be compliant with the new "
"regulation."
msgstr ""
"Du är på väg att använda ett momsregistreringsnummer för att registrera dig."
" Försäkra dig om att du registrerar dig med ditt bolagsregisternummer "
"(BCE/KBO) för att följa gällande lagstiftning."

#. module: account_peppol
# override | officiell: 'Ditt företag är redan registrerat på en Åtkomstpunkt
# (%s) för att ta emot fakturor. Vi kommer endast att registrera er som
# avsändare i Odoo.'
msgid ""
"Your company is already registered on an Access Point (%s) for receiving "
"invoices. We will register you on Odoo as a sender only."
msgstr ""
"Ditt bolag är redan registrerat på en Åtkomstpunkt (%s) för att ta emot "
"fakturor. Vi kommer endast att registrera er som avsändare i Odoo."

#. module: account_peppol
# override | officiell: "[PEPPOL-EN16931-R020] En digital adress (EAS) måste
# anges för företaget '%s'."
msgid ""
"[PEPPOL-EN16931-R020] An electronic address (EAS) must be provided on the "
"company '%s'."
msgstr ""
"[PEPPOL-EN16931-R020] En digital adress (EAS) måste anges för bolaget '%s'."

#. module: account_peppol
# override | officiell: 'Den rekommenderade identifieringsmetoden för Belgien
# är ditt företagsregistreringsnummer.'
msgid ""
"The recommended identification method for Belgium is your Company Registry "
"Number."
msgstr ""
"Den rekommenderade identifieringsmetoden för Belgien är ditt "
"bolagsregistreringsnummer."
