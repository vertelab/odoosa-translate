#. module: stock_account
# override | officiell: 'Företag'
msgid "Companies"
msgstr "Bolag"

#. module: stock_account
# override | officiell: 'Företag'
msgid "Company"
msgstr "Bolag"

#. module: stock_account
# override | officiell: 'Företagets valuta'
msgid "Company Currency"
msgstr "Bolagets valuta"

#. module: stock_account
# override | officiell: 'Standardpris: Produkterna värderas till deras
# standardkostnad definierad på produkten.\n        Genomsnittskostnad (AVCO):
# Produkterna värderas till vägt genomsnittskostnad.\n        First In First
# Out (FIFO): Produkterna värderas med antagandet att de som kommer in i
# företaget först också kommer att lämna det först.'
msgid ""
"Standard Price: The products are valued at their standard cost defined on the product.\n"
"        Average Cost (AVCO): The products are valued at weighted average cost.\n"
"        First In First Out (FIFO): The products are valued supposing those that enter the company first will also leave it first.\n"
"        "
msgstr ""
"Standardpris: Produkterna värderas till deras standardkostnad definierad på produkten.\n"
"        Genomsnittskostnad (AVCO): Produkterna värderas till vägt genomsnittskostnad.\n"
"        First In First Out (FIFO): Produkterna värderas med antagandet att de som kommer in i bolaget först också kommer att lämna det först."

#. module: stock_account
# override | officiell: 'Tekniskt fält för att korrekt visa den valda
# företagets valuta som motsvarar det totala värdet av produktens
# värderingslager'
msgid ""
"Technical field to correctly show the currently selected company's currency "
"that corresponds to the totaled value of the product's valuation layers"
msgstr ""
"Tekniskt fält för att korrekt visa den valda bolagets valuta som motsvarar "
"det totala värdet av produktens värderingslager"

#. module: stock_account
# override | officiell: 'Manuell: Verifikaten för att värdera lagret bokförs
# inte automatiskt.\n        Automatiserad: En verifikat skapas automatiskt
# för att värdera lagret när en produkt kommer in i eller lämnar företaget.'
msgid ""
"Manual: The accounting entries to value the inventory are not posted automatically.\n"
"        Automated: An accounting entry is automatically created to value the inventory when a product enters or leaves the company.\n"
"        "
msgstr ""
"Manuell: Verifikaten för att värdera lagret bokförs inte automatiskt.\n"
"        Automatiserad: En verifikat skapas automatiskt för att värdera lagret när en produkt kommer in i eller lämnar bolaget."
