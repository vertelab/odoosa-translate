msgstr "Visa menyn för kundämnen"

#. module: crm
# override | officiell: 'Visa bara leads'
msgid "Show only lead"
msgstr "Visa bara kundämnen"

#. module: crm
# override | officiell: 'Visa bara leads'
msgid "Show only leads"
msgstr "Visa bara kundämnen"

#. module: crm
# override | officiell: 'Kontakterna nedan har lagts till som följare av detta
