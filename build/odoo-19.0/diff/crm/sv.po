# override | officiell: 'Inga tilldelade leads till teamet %(team_name)s och
# dess säljare eftersom ingen otilldelad lead matchar dess domän.'
msgid ""
"No allocated leads to %(team_name)s team and its salespersons because no "
"unassigned lead matches its domain."
msgstr ""
"Inga tilldelade kundämnen till teamet %(team_name)s och dess säljare "
"eftersom ingen otilldelad kundämne matchar dess domän."

#. module: crm
# override | officiell: 'Inga allokerade leads till teamet %(team_name)s
# eftersom det inte har någon kapacitet. Lägg till kapacitet till säljarna.'
