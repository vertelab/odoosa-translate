msgstr "<span class=\"o_stat_text\">Kundämnen</span>"

#. module: crm
# override | officiell: 'Leadkapacitet i snitt (på 30 dagar)'
msgid "Average Leads Capacity (on 30 days)"
msgstr "Kundämnekapacitet i snitt (på 30 dagar)"

#. module: crm
# override | officiell: 'Företag'
msgid "Company"
msgstr "Bolag"

#. module: crm
# override | officiell: 'Information om företaget'
msgid "Company Information"
msgstr "Information om bolaget"

#. module: crm
# override | officiell: 'Företagsnamn'
msgid "Company Name"
msgstr "Bolagsnamn"

#. module: crm
