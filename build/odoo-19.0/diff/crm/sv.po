msgstr ""
"Inga kundämnen tilldelade till säljare eftersom inga otilldelade kundämnen "
"matchar deras domäner."

#. module: crm
# override | officiell: 'Inga nya leads tilldelade till teamet %(team_name)s
# eftersom inga otilldelade leads matchar dess domän.'
msgid ""
"No new lead allocated to %(team_name)s team because no unassigned lead "
"matches its domain."
msgstr ""
"Inga nya kundämnen tilldelade till teamet %(team_name)s eftersom inga "
"otilldelade kundämnen matchar dess domän."

#. module: crm
# override | officiell: 'Inga nya leads har tilldelats teamen eftersom inga
# leads matchar deras domäner.'
msgid ""
"No new lead allocated to the teams because no lead match their domains."
msgstr ""
"Inga nya kundämnen har tilldelats teamen eftersom inga kundämnen matchar "
"deras domäner."

#. module: crm
# override | officiell: 'Antal leads och möjligheter tilldelade den gångna
