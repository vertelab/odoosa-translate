"<span>Periodically assign leads based on priorities and filters.</span><br/>\n"
"                                <span invisible=\"not crm_use_auto_assignment\">\n"
"                                    All sales teams will use this setting by default unless\n"
"                                    specified otherwise.\n"
"                                </span>"
msgstr ""
"<span>Periodisk tilldelning av kundämnen baserat på prioriteringar och filter.</span><br/>\n"
"                                <span invisible=\"not crm_use_auto_assignment\">\n"
"                                    Alla säljteam kommer att använda den här inställningen som standard om\n"
"                                    annat anges.\n"
"                                </span>"

#. module: crm
# override | officiell: 'En lead i ett Won-stadium kan inte förloras. Flytta
# den först till ett annat steg.'
msgid "A lead in a Won stage cannot be lost. Move it to another stage first."
msgstr ""
"En kundämne i ett Won-stadium kan inte förloras. Flytta den först till ett "
"annat steg."

#. module: crm
# override | officiell: 'En ny lead har skapats och är inte tilldelad något
# team.'
msgid "A new lead has been created and is not assigned to any team."
msgstr "En ny kundämne har skapats och är inte tilldelad något team."

#. module: crm
# override | officiell: 'En ny lead har skapats för teamet "%(team_name)s".'
msgid "A new lead has been created for the team \"%(team_name)s\"."
msgstr "En ny kundämne har skapats för teamet \"%(team_name)s\"."

#. module: crm
# override | officiell: 'Aktiva leads'
msgid "Active Leads"
msgstr "Aktiva kundämnen"

#. module: crm
# override | officiell: 'Aktiviteter som markerats som utförda på leads visas
# här, vilket ger en översikt över interaktioner med leads.'
msgid ""
"Activities marked as Done on Leads will appear here, providing an overview "
"of lead interactions."
msgstr ""
"Aktiviteter som markerats som utförda på kundämnen visas här, vilket ger en "
"översikt över interaktioner med kundämnen."

#. module: crm
# override | officiell: 'Tilldela leads'
msgid "Assign Leads"
msgstr "Tilldela kundämnen"

#. module: crm
# override | officiell: 'Associerad lead'
msgid "Associated Lead"
msgstr "Associerad kundämne"

#. module: crm
# override | officiell: 'Leadkapacitet i snitt (på 30 dagar)'
msgid "Average Leads Capacity (on 30 days)"
msgstr "Kundämnekapacitet i snitt (på 30 dagar)"

#. module: crm
# override | officiell: 'CRM: Tilldelning av leads'
msgid "CRM: Lead Assignment"
msgstr "CRM: Tilldelning av kundämnen"

#. module: crm
# override | officiell: 'Kontrollera etapperna för leads för att identifiera
# flaskhalsar i din säljprocess.'
msgid ""
"Check the Stage Tracker of Leads to identify bottlenecks in your Sales "
"process."
msgstr ""
"Kontrollera etapperna för kundämnen för att identifiera flaskhalsar i din "
"säljprocess."

#. module: crm
# override | officiell: 'Bocka i rutan för att filtrera och kvalificera
# inkommande förfrågningar som leads innan de konverteras till
# affärsmöjligheter och knyts till en säljare.'
msgid ""
"Check this box to filter and qualify incoming requests as leads before "
"converting them into opportunities and assigning them to a salesperson."
msgstr ""
"Bocka i rutan för att filtrera och kvalificera inkommande förfrågningar som "
"kundämnen innan de konverteras till affärsmöjligheter och knyts till en "
"säljare."

#. module: crm
# override | officiell: 'Klassificera och analysera dina kategorier för
# leads/möjligheter som till exempel: utbildning, service'
msgid ""
"Classify and analyze your lead/opportunity categories like: Training, "
"Service"
msgstr ""
"Klassificera och analysera dina kategorier för kundämnen/möjligheter som "
"till exempel: utbildning, service"

#. module: crm
# override | officiell: 'Avslutade/döda leads kan inte omvandlas till
# affärsmöjligheter.'
msgid "Closed/Dead leads cannot be converted into opportunities."
msgstr "Avslutade/döda kundämnen kan inte omvandlas till affärsmöjligheter."

