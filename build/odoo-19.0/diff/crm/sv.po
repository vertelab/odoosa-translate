#. module: crm
# override | officiell: '<b>Skriv ett par tecken</b> för att söka efter ett
# företag eller skapa ett nytt.'
msgid "<b>Write a few letters</b> to look for a company, or create a new one."
msgstr ""
"<b>Skriv ett par tecken</b> för att söka efter ett bolag eller skapa ett "
"nytt."

#. module: crm
# override | officiell: '<i class="fa fa-building" title="Företag"/>'
msgid "<i class=\"fa fa-building\" title=\"Company\"/>"
msgstr "<i class=\"fa fa-building\" title=\"Bolag\"/>"

