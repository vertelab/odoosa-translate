# override | officiell: '<i class="fa fa-info-circle me-2" title="Assigned
# Lead Count"/>'
msgid "<i class=\"fa fa-info-circle me-2\" title=\"Assigned Lead Count\"/>"
msgstr "<i class=\"fa fa-info-circle me-2\" title=\"Assigned Kundämne Count\"/>"

