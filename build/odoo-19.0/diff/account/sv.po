#. module: account
# override | officiell: 'Bank- och kassakonton kan inte delas mellan företag.'
msgid "Bank & Cash accounts cannot be shared between companies."
msgstr "Bank- och kassakonton kan inte delas mellan bolag."

#. module: account
# override | officiell: 'Kontonummer för det bankkonto som fakturan kommer att
# betalas till. Ett företagskonto om detta är en kundfaktura eller
# leverantörskreditfaktura, annars ett partnerkonto.'
msgid ""
"Bank Account Number to which the invoice will be paid. A Company bank "
"account if this is a Customer Invoice or Vendor Credit Note, otherwise a "
"Partner bank account number."
msgstr ""
"Kontonummer för det bankkonto som fakturan kommer att betalas till. Ett "
"bolagskonto om detta är en kundfaktura eller leverantörskreditfaktura, "
"annars ett partnerkonto."

#. module: account
# override | officiell: 'Tillhör samma företag som %s.'
msgid "Belongs to the same company as %s."
msgstr "Tillhör samma bolag som %s."

#. module: account
# override | officiell: 'Företagslicenser och tillstånd som ditt företag måste
# betala för att bedriva sin verksamhet'
msgid "Business licenses and permits that your company must pay to operate"
msgstr ""
"Bolagslicenser och tillstånd som ditt bolag måste betala för att bedriva sin"
" verksamhet"

#. module: account
# override | officiell: 'Det är inte möjligt att ändra metoden som används för
# att beräkna moms för ett företag som redan har utfärdat fakturor.'
msgid ""
"Cannot change Price Tax computation method on a company that has already "
"started invoicing."
msgstr ""
"Det är inte möjligt att ändra metoden som används för att beräkna moms för "
"ett bolag som redan har utfärdat fakturor."

#. module: account
# override | officiell: 'Ingen kontoplan hittades för det här företaget, den
# bör därmed konfigureras.\nVänligen gå till Kontoinställningar.'
msgid ""
"Cannot find a chart of accounts for this company, You should configure it. \n"
"Please go to Account Configuration."
msgstr ""
"Ingen kontoplan hittades för det här bolaget, den bör därmed konfigureras.\n"
"Vänligen gå till Kontoinställningar."

#. module: account
# override | officiell: 'Företag'
msgid "Companies"
msgstr "Bolag"

#. module: account
