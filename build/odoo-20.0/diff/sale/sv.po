msgid ""
msgstr ""
"Project-Id-Version: odoosa-diff-sale\n"
"Language: sv\n"

#. module: sale
# new-corrected | officiell: 'Att ändra företag för en befintlig offert kan
# kräva manuella justeringar av detaljerna i raderna. Du kan överväga att
# uppdatera priserna.'
msgid ""
"Changing the company of an existing quotation might need some manual "
"adjustments in the details of the lines. You might consider updating the "
"prices."
msgstr ""
"Att ändra bolag för en befintlig offert kan kräva manuella justeringar av "
"detaljerna i raderna. Du kan överväga att uppdatera priserna."

#. module: sale
# new-corrected | officiell: 'Företag'
msgid "Company"
msgstr "Bolag"

#. module: sale
# new-corrected | officiell: 'Layout för företagsdokument'
msgid "Company Document Layout"
msgstr "Layout för bolagsdokument"

#. module: sale
# new-corrected | officiell: 'Standard om huruvida det försäljningspris som
# används på produkten och fakturor med detta företag inkluderar skatter.'
msgid ""
"Default on whether the sales price used on the product and invoices with "
"this Company includes its taxes."
msgstr ""
"Standard om huruvida det försäljningspris som används på produkten och "
"fakturor med detta bolag inkluderar skatter."

#. module: sale
# new-corrected | officiell: 'Företaget är obligatoriskt, vänligen välj ett
# innan du gör några andra ändringar i försäljningsordern.'
msgid ""
"The company is required, please select one before making any other changes "
"to the sale order."
msgstr ""
"Bolaget är obligatoriskt, vänligen välj ett innan du gör några andra "
"ändringar i försäljningsordern."

#. module: sale
# new-corrected | officiell: 'Följande produkter kan inte begränsas till
# företaget %(company)s eftersom de redan har använts i offerter eller
# försäljningsorder i ett annat företag:\n%(used_products)s\nDu kan arkivera
# dessa produkter och återskapa dem med din företagsbegränsning istället,
# eller låta dem vara delade produkter.'
msgid ""
"The following products cannot be restricted to the company %(company)s because they have already been used in quotations or sales orders in another company:\n"
"%(used_products)s\n"
"You can archive these products and recreate them with your company restriction instead, or leave them as shared product."
msgstr ""
"Följande produkter kan inte begränsas till bolaget %(company)s eftersom de redan har använts i offerter eller försäljningsorder i ett annat bolag:\n"
"%(used_products)s\n"
"Du kan arkivera dessa produkter och återskapa dem med din bolagsbegränsning istället, eller låta dem vara delade produkter."

#. module: sale
# new-corrected | officiell: 'Det verkar inte finnas någon rabattprodukt
# konfigurerad för det här företaget ännu. Du kan antingen använda en rabatt
# per linje eller be en administratör att bevilja rabatten första gången.'
msgid ""
"There does not seem to be any discount product configured for this company "
"yet. You can either use a per-line discount, or ask an administrator to "
"grant the discount the first time."
msgstr ""
"Det verkar inte finnas någon rabattprodukt konfigurerad för det här bolaget "
"ännu. Du kan antingen använda en rabatt per linje eller be en administratör "
"att bevilja rabatten första gången."

#. module: sale
# new-corrected | officiell: 'Värden som anges här är företagsspecifika.'
msgid "Values set here are company-specific."
msgstr "Värden som anges här är bolagsspecifika."

#. module: sale
# new-corrected | officiell: 'Varning för byte av företag för din offert'
msgid "Warning for the change of your quotation's company"
msgstr "Varning för byte av bolag för din offert"
