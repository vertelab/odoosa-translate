#
msgid ""
msgstr ""
"Project-Id-Version: odoosa-diff-base\n"
"Language: sv\n"

#. module: base
# new-corrected | officiell: 'Markera denna ruta om kontakten är ett företag,
# annars är det en person'
msgid "Check if the contact is a company, otherwise it is a person"
msgstr "Markera denna ruta om kontakten är ett bolag, annars är det en person"

#. module: base
# new-corrected | officiell: 'Företag'
msgid "Company"
msgstr "Bolag"

#. module: base
# new-corrected | officiell: 'Företag'
msgid "Company Employer"
msgstr "Bolag"

#. module: base
# new-corrected | officiell: 'Företagslogo'
msgid "Company Logo"
msgstr "Bolagslogo"

#. module: base
# new-corrected | officiell: 'Företagsnamn'
msgid "Company Name"
msgstr "Bolagsnamn"

#. module: base
# new-corrected | officiell: 'Företagets namn'
msgid "Company Name Entity"
msgstr "Bolagets namn"

#. module: base
# new-corrected | officiell: 'Företagets slogan'
msgid "Company Tagline"
msgstr "Bolagets slogan"

#. module: base
# new-corrected | officiell: 'Företagets slogan, som inkluderas i ett tryckt
# dokuments sidhuvud eller sidfot (beroende på vald layout).'
msgid ""
"Company tagline, which is included in a printed document's header or footer "
"(depending on the selected layout)."
msgstr ""
"Bolagets slogan, som inkluderas i ett tryckt dokuments sidhuvud eller sidfot"
" (beroende på vald layout)."

#. module: base
# new-corrected | officiell: 'Skapa ett nytt företag'
msgid "Create a new company"
msgstr "Skapa ett nytt bolag"

#. module: base
# new-corrected | officiell: 'Skapa och hantera de företag som ska hanteras av
# Odoo härifrån. Butiker eller dotterbolag kan skapas och underhållas
# härifrån.'
msgid ""
"Create and manage the companies that will be managed by Odoo from here. "
"Shops or subsidiaries can be created and maintained from here."
msgstr ""
"Skapa och hantera de bolag som ska hanteras av Odoo härifrån. Butiker eller "
"dotterbolag kan skapas och underhållas härifrån."

#. module: base
# new-corrected | officiell: 'Standardföretag'
msgid "Default Company"
msgstr "Standardbolag"

#. module: base
# new-corrected | officiell: 'Bestämmer var kundens/företagets namn ska
# placeras, dvs. efter eller före adressen.'
msgid ""
"Determines where the customer/company name should be placed, i.e. after or "
"before the address."
msgstr ""
"Bestämmer var kundens/bolagets namn ska placeras, dvs. efter eller före "
"adressen."

#. module: base
# new-corrected | officiell: 'Det är inte tillåtet att duplicera ett företag.
# Skapa ett nytt företag i stället.'
msgid ""
"Duplicating a company is not allowed. Please create a new company instead."
msgstr ""
"Det är inte tillåtet att duplicera ett bolag. Skapa ett nytt bolag i "
"stället."

#. module: base
# new-corrected | officiell: 'Värde motsvarande 1 enhet av företagets valuta i
# grundvalutan.'
msgid "Exchange rate from the company currency to this currency"
msgstr "Värde motsvarande 1 enhet av bolagets valuta i grundvalutan."

#. module: base
# new-corrected | officiell: 'Om angiven knyts åtgärden bara till detta
# företag'
msgid "If set, action binding only applies for this company"
msgstr "Om angiven knyts åtgärden bara till detta bolag"

#. module: base
# new-corrected | officiell: 'Omvänd företagsränta'
msgid "Inverse Company Rate"
msgstr "Omvänd bolagsränta"

#. module: base
# new-corrected | officiell: 'Är företag'
msgid "Is Company"
msgstr "Är bolag"

#. module: base
# new-corrected | officiell: 'Is Företagsuppgifter Tom'
msgid "Is Company Details Empty"
msgstr "Is Bolagsuppgifter Tom"

#. module: base
# new-corrected | officiell: 'Är företagets nuvarande valuta'
msgid "Is Current Company Currency"
msgstr "Är bolagets nuvarande valuta"

#. module: base
# new-corrected | officiell: 'Är ett företag'
msgid "Is a Company"
msgstr "Är ett bolag"

#. module: base
# new-corrected | officiell: 'Flera företag'
msgid "Multi Companies"
msgstr "Flera bolag"

#. module: base
# new-corrected | officiell: 'Antal företag'
msgid "Number of Companies"
msgstr "Antal bolag"

#. module: base
# new-corrected | officiell: 'Relaterat företag'
msgid "Related Company"
msgstr "Relaterat bolag"

#. module: base
# new-corrected | officiell: 'Företaget %(company_name)s kan inte arkiveras
# eftersom det fortfarande används som standardföretag av
# %(active_users)s-användare.'
msgid ""
"The company %(company_name)s cannot be archived because it is still used as "
"the default company of %(active_users)s users."
msgstr ""
"Bolaget %(company_name)s kan inte arkiveras eftersom det fortfarande används"
" som standardbolag av %(active_users)s-användare."

#. module: base
# new-corrected | officiell: 'Det företag som tilldelats denna partner stämmer
# inte överens med det företag som denna partner representerar.'
msgid ""
"The company assigned to this partner does not match the company this partner"
" represents."
msgstr ""
"Det bolag som tilldelats denna partner stämmer inte överens med det bolag "
"som denna partner representerar."

#. module: base
# new-corrected | officiell: 'Företagshierarkin kan inte ändras.'
msgid "The company hierarchy cannot be changed."
msgstr "Bolagshierarkin kan inte ändras."

#. module: base
# new-corrected | officiell: 'Företagsnamnet måste vara unikt!'
msgid "The company name must be unique!"
msgstr "Bolagsnamnet måste vara unikt!"

#. module: base
# new-corrected | officiell: 'Standardföretaget för den här användaren.'
msgid "The default company for this user."
msgstr "Standardbolaget för den här användaren."

#. module: base
# new-corrected | officiell: 'Det valda företaget är inte kompatibelt med
# företagen för den eller de relaterade användarna'
msgid ""
"The selected company is not compatible with the companies of the related "
"user(s)"
msgstr ""
"Det valda bolaget är inte kompatibelt med bolagen för den eller de "
"relaterade användarna"

#. module: base
# new-corrected | officiell: 'Denna valuta är inställd på ett företag och kan
# därför inte avaktiveras.'
msgid "This currency is set on a company and therefore cannot be deactivated."
msgstr ""
"Denna valuta är inställd på ett bolag och kan därför inte avaktiveras."

#. module: base
# new-corrected | officiell: 'Detta är företagets valuta.'
msgid "This is your company's currency."
msgstr "Detta är bolagets valuta."

#. module: base
# new-corrected | officiell: 'Används för att beställa företag i
# företagsväxlaren'
msgid "Used to order Companies in the company switcher"
msgstr "Används för att beställa bolag i bolagsväxlaren"

#. module: base
# new-corrected | officiell: 'Värde motsvarande 1 enhet av grundvalutan i
# företagets valuta.'
msgid "Value of 1 unit of this currency in the company currency"
msgstr "Värde motsvarande 1 enhet av grundvalutan i bolagets valuta."

#. module: base
# new-corrected | officiell: 'Huruvida värden för detta fält är
# företagsberoende'
msgid "Whether values for this field is company dependent"
msgstr "Huruvida värden för detta fält är bolagsberoende"

#. module: base
# new-corrected | officiell: 't.ex. Mitt Företag'
msgid "e.g. My Company"
msgstr "t.ex. Mitt Bolag"
